---
import Layout from "../layouts/Layout.astro";
import {
  Mail,
  ExternalLink,
  ArrowRight,
  Layers,
  Server,
  Database,
  Container,
  Brain,
  Code2,
  Globe,
  Waypoints,
  Boxes,
  Search,
  Download,
} from "@lucide/astro";
---

<Layout title="Juan Pablo Galvis — Desarrollador Full Stack">
  <!-- NAV -->
  <nav class="nav">
    <div class="nav-inner">
      <a href="#" class="nav-logo">JPG</a>
      <div class="nav-links">
        <a href="#proyectos">Proyectos</a>
        <a href="#habilidades">Habilidades</a>
        <a href="#contacto">Contacto</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <header class="hero">
    <div class="container" data-animate>
      <p class="hero-label">Ingeniero de Sistemas · Desarrollador Full Stack</p>
      <h1 class="hero-title">
        Construyo soluciones de software<br />
        desde la arquitectura hasta la interfaz
      </h1>
      <p class="hero-description">
        Diseño, desarrollo e integro sistemas completos — desde el modelado de datos y la comunicación entre servicios
        hasta interfaces funcionales y adaptables. Me interesa entender cómo se conectan las partes de un sistema
        y construir soluciones que funcionen de forma coherente.
      </p>
      <div class="hero-actions">
        <a href="#proyectos" class="btn btn-primary">
          Ver proyectos
          <ArrowRight size={16} />
        </a>
        <a href="/CV_Juan_Galvis.pdf" download class="btn btn-secondary">
          <Download size={16} />
          Descargar CV
        </a>
        <a href="#contacto" class="btn btn-secondary">Contacto</a>
      </div>
    </div>
  </header>

  <!-- PROJECTS -->
  <section id="proyectos" class="section section-projects">
    <div class="container">
      <h2 class="section-title" data-animate>Proyectos principales</h2>

      <!-- DROVIK -->
      <article class="project project-featured" data-animate>
        <div class="project-content">
          <div class="project-header">
            <h3 class="project-name">Drovik</h3>
            <span class="project-type">Logistics Intelligence Platform</span>
          </div>
          <p class="project-description">
            Plataforma de gestión logística construida con una arquitectura de microservicios.
            Cinco servicios independientes — identidad, flotas, envíos, simulación e incidentes — se comunican
            a través de un API Gateway (YARP), con un bus de eventos asíncrono (RabbitMQ) y actualizaciones
            en tiempo real (SignalR).
          </p>
          <p class="project-description">
            El proyecto demuestra cómo organizar un sistema distribuido: separar responsabilidades por dominio,
            gestionar la comunicación entre componentes y mantener una arquitectura coherente y escalable.
            Utiliza datos sintéticos para representar operaciones logísticas.
          </p>
          <ul class="project-highlights">
            <li>5 microservicios con bases de datos independientes (SQL Server)</li>
            <li>API Gateway con YARP para routing centralizado</li>
            <li>Bus de eventos asíncrono con RabbitMQ</li>
            <li>Actualizaciones en tiempo real con SignalR</li>
            <li>Frontend Angular con TypeScript, PrimeNG y Leaflet</li>
            <li>Infraestructura con Docker Compose y OpenTelemetry</li>
          </ul>
          <div class="project-tech">
            <span>Angular</span><span>.NET</span><span>SQL Server</span><span>RabbitMQ</span><span>YARP</span><span>SignalR</span><span>Docker</span>
          </div>
          <div class="project-links">
            <a href="https://github.com/JuanGal99/DROVIK" target="_blank" rel="noopener" class="btn btn-small">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
              Repositorio
            </a>
          </div>
        </div>
        <div class="project-images">
          <div class="project-image">
            <img src="/drovik-preview.webp" alt="Simulación de operaciones en vivo de Drovik" loading="lazy" />
          </div>
          <div class="project-image">
            <img src="/drovik-dashboard.png" alt="Centro de operaciones y red logística de Drovik" loading="lazy" />
          </div>
        </div>
      </article>

      <!-- LICOMART -->
      <article class="project project-featured" data-animate>
        <div class="project-content">
          <div class="project-header">
            <h3 class="project-name">LicoMart</h3>
            <span class="project-type">E-commerce</span>
          </div>
          <p class="project-description">
            Aplicación de comercio electrónico Full Stack que cubre el flujo completo de compra:
            desde la exploración del catálogo hasta la gestión del carrito. Frontend y backend
            conectados mediante una API, con persistencia en base de datos y ejecución containerizada.
          </p>
          <ul class="project-highlights">
            <li>Catálogo de productos con gestión completa</li>
            <li>Carrito de compras funcional</li>
            <li>API de comunicación frontend-backend</li>
            <li>Base de datos para persistencia de información</li>
            <li>Entorno Docker para desarrollo local</li>
          </ul>
          <div class="project-tech">
            <span>React</span><span>Tailwind CSS</span><span>Django</span><span>MySQL</span><span>Docker</span>
          </div>
          <div class="project-links">
            <a href="https://github.com/JuanGal99/LicoMart" target="_blank" rel="noopener" class="btn btn-small">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
              Repositorio
            </a>
          </div>
        </div>
        <div class="project-images">
          <div class="project-image">
            <img src="/licomart-dashboard.png" alt="Panel de administración con ingresos y pedidos recientes de LicoMart" loading="lazy" />
          </div>
          <div class="project-image">
            <img src="/licomart-catalog.webp" alt="Catálogo de productos con filtros y carrito de LicoMart" loading="lazy" />
          </div>
        </div>
      </article>

      <!-- DRA. PAULA GALVIS -->
      <article class="project project-featured" data-animate>
        <div class="project-content">
          <div class="project-header">
            <h3 class="project-name">Dra. Paula Galvis</h3>
            <span class="project-type">Landing page profesional</span>
          </div>
          <p class="project-description">
            Sitio web real, actualmente desplegado, desarrollado para una profesional de odontología.
            Diseñado para presentar servicios, facilitar el contacto con pacientes y funcionar
            correctamente en cualquier dispositivo. Contenido disponible en español e inglés.
          </p>
          <ul class="project-highlights">
            <li>Diseño responsive profesional</li>
            <li>Contenido bilingüe español/inglés</li>
            <li>Formulario de contacto funcional</li>
            <li>Proyecto real desplegado en producción</li>
          </ul>
          <div class="project-tech">
            <span>React</span><span>Tailwind CSS</span><span>i18next</span><span>Formspree</span><span>Netlify</span>
          </div>
          <div class="project-links">
            <a href="https://drapaulagalvis.com" target="_blank" rel="noopener" class="btn btn-small">
              <ExternalLink size={14} />
              Ver sitio
            </a>
            <a href="https://github.com/JuanGal99/Dra.Paula-Galvis" target="_blank" rel="noopener" class="btn btn-small">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
              Repositorio
            </a>
          </div>
        </div>
        <div class="project-images">
          <div class="project-image">
            <img src="/paula-galvis-preview.webp" alt="Landing page de Dra. Paula Galvis" loading="lazy" />
          </div>
          <div class="project-image">
            <img src="/paula-galvis-contact.png" alt="Formulario de contacto de Dra. Paula Galvis" loading="lazy" />
          </div>
        </div>
      </article>

      <!-- ODONTOFLOW -->
      <article class="project" data-animate>
        <div class="project-content">
          <div class="project-header">
            <h3 class="project-name">OdontoFlow</h3>
            <span class="project-type">Plataforma de gestión odontológica</span>
            <span class="project-status">En progreso</span>
          </div>
          <p class="project-description">
            Solución para administrar las operaciones de consultorios odontológicos independientes.
            Contempla la gestión de pacientes, organización de citas, administración de profesionales
            y auxiliares con diferentes roles, y una arquitectura multi-tenant que permite separar
            la información de cada consultorio.
          </p>
          <ul class="project-highlights">
            <li>Gestión de consultorios y pacientes</li>
            <li>Organización de citas y agenda</li>
            <li>Sistema de usuarios, roles y permisos</li>
            <li>Arquitectura multi-tenant</li>
          </ul>
          <div class="project-links">
            <a href="https://github.com/JuanGal99/OdontoFlow" target="_blank" rel="noopener" class="btn btn-small">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
              Repositorio
            </a>
          </div>
        </div>
      </article>

    </div>
  </section>

  <!-- SKILLS -->
  <section id="habilidades" class="section section-skills">
    <div class="container">
      <h2 class="section-title" data-animate>Habilidades y áreas de trabajo</h2>
      <p class="section-intro" data-animate>
        Estas son las áreas en las que trabajo y desarrollo mis capacidades como ingeniero de software.
        No es una lista de dominio completo — es el mapa de lo que he construido, estudiado y aplicado en proyectos reales.
      </p>
      <div class="skills-grid" data-stagger>
        <div class="skill-item" data-stagger-child>
          <div class="skill-icon"><Layers size={20} /></div>
          <h3>Desarrollo Full Stack</h3>
          <p>Interfaces de usuario, lógica de servidor, APIs y bases de datos en un mismo flujo de trabajo.</p>
        </div>
        <div class="skill-item" data-stagger-child>
          <div class="skill-icon"><Code2 size={20} /></div>
          <h3>Frontend</h3>
          <p>Construcción de interfaces modernas, funcionales y adaptables a diferentes dispositivos.</p>
        </div>
        <div class="skill-item" data-stagger-child>
          <div class="skill-icon"><Server size={20} /></div>
          <h3>Backend</h3>
          <p>Servicios, lógica de negocio y procesamiento de información del lado del servidor.</p>
        </div>
        <div class="skill-item" data-stagger-child>
          <div class="skill-icon"><Waypoints size={20} /></div>
          <h3>Diseño de APIs</h3>
          <p>Estructuración de servicios y comunicación entre componentes de software.</p>
        </div>
        <div class="skill-item" data-stagger-child>
          <div class="skill-icon"><Database size={20} /></div>
          <h3>Bases de datos</h3>
          <p>Modelado de información, diseño de estructuras y gestión de datos.</p>
        </div>
        <div class="skill-item" data-stagger-child>
          <div class="skill-icon"><Boxes size={20} /></div>
          <h3>Arquitectura de software</h3>
          <p>Patrones arquitectónicos, separación de responsabilidades y organización de sistemas.</p>
        </div>
        <div class="skill-item" data-stagger-child>
          <div class="skill-icon"><Globe size={20} /></div>
          <h3>Microservicios</h3>
          <p>Construcción de sistemas con servicios independientes y comunicación entre ellos.</p>
        </div>
        <div class="skill-item" data-stagger-child>
          <div class="skill-icon"><Container size={20} /></div>
          <h3>Contenerización</h3>
          <p>Organización y ejecución de aplicaciones mediante entornos reproducibles.</p>
        </div>
        <div class="skill-item" data-stagger-child>
          <div class="skill-icon"><Brain size={20} /></div>
          <h3>Inteligencia artificial</h3>
          <p>Interés y formación en aprendizaje automático, redes neuronales y modelos generativos.</p>
        </div>
        <div class="skill-item" data-stagger-child>
          <div class="skill-icon"><Search size={20} /></div>
          <h3>Resolución de problemas</h3>
          <p>Análisis de requerimientos, investigación técnica y desarrollo de soluciones.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section section-about">
    <div class="container">
      <h2 class="section-title" data-animate>Sobre mí</h2>
      <div class="about-content" data-animate>
        <p>
          Soy estudiante de Ingeniería de Sistemas, próximo a graduarme. Mi trabajo se centra en el desarrollo
          de software Full Stack: desde la estructura de datos y la lógica del servidor hasta la interfaz que
          usa el usuario final.
        </p>
        <p>
          Me interesa entender cómo funcionan los sistemas completos — no solo escribir código, sino diseñar
          cómo se comunican los componentes, cómo se organizan las responsabilidades y cómo una solución
          puede crecer sin perder coherencia.
        </p>
        <p>
          Soy autodidacta. Me gusta investigar, probar herramientas nuevas y enfrentar problemas que me
          obliguen a pensar diferente. Mi objetivo es seguir creciendo como ingeniero de software,
          participar en proyectos reales y construir soluciones bien pensadas.
        </p>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contacto" class="section section-contact">
    <div class="container">
      <h2 class="section-title" data-animate>Contacto</h2>
      <p class="section-intro" data-animate>
        Si te interesa mi perfil, quieres conversar sobre un proyecto o simplemente conectar,
        estos son los mejores canales para encontrarme.
      </p>
      <div class="contact-links" data-stagger>
        <a href="mailto:juanpablogalvisperez10@gmail.com" class="contact-item" data-stagger-child>
          <Mail size={20} />
          <span>juanpablogalvisperez10@gmail.com</span>
        </a>
        <a href="https://github.com/JuanGal99" target="_blank" rel="noopener" class="contact-item" data-stagger-child>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          <span>GitHub</span>
        </a>
        <a href="https://www.linkedin.com/in/juan-galvis99/" target="_blank" rel="noopener" class="contact-item" data-stagger-child>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          <span>LinkedIn</span>
        </a>
        <a href="/CV_Juan_Galvis.pdf" download class="contact-item" data-stagger-child>
          <Download size={20} />
          <span>Descargar CV</span>
        </a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <p>Juan Pablo Galvis · {new Date().getFullYear()}</p>
    </div>
  </footer>
</Layout>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(244, 246, 250, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .nav-logo:hover { text-decoration: none; }
  .nav-links {
    display: flex;
    gap: 32px;
  }
  .nav-links a {
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .hero {
    padding: 140px 0 80px;
    background:
      radial-gradient(ellipse 80% 60% at 20% 0%, rgba(45, 91, 227, 0.07) 0%, transparent 60%),
      radial-gradient(ellipse 50% 50% at 80% 20%, rgba(120, 80, 220, 0.04) 0%, transparent 50%),
      var(--bg-cool);
  }
  .hero-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .hero-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    max-width: 720px;
    margin-bottom: 24px;
  }
  .hero-description {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: 32px;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 10px 20px;
    border-radius: 8px;
